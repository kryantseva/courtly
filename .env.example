POSTGRES_DB=courtly
POSTGRES_USER=courtly
POSTGRES_PASSWORD=courtly
# Docker Compose: сервис БД называется db. С хоста (migrate без Docker): 127.0.0.1 и порт 15432
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Пример для локального postgres после docker compose up db:
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=15432

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Секрет HMAC для POST /api/webhooks/payments/ (сырое тело запроса). Пусто = webhook отвечает 503.
PAYMENT_WEBHOOK_SECRET=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local
# Трейсы/профили в Sentry (0 = выкл.). PII по-прежнему отключён (before_send чистит заголовки/тело).
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
# Имя сервиса в логах и Sentry server_name / тег service
SERVICE_NAME=courtly-api

# Vite (frontend): подключение к Django API (регистрация, филиалы, брони и т.д.)
# После migrate: python manage.py seed_full_database (или по отдельности seed_demo_users, seed_journal_demo)
VITE_USE_API=true
VITE_API_URL=http://localhost:8000
# Чистый UI без бэкенда: VITE_USE_API=false
